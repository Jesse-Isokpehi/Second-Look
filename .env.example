# Copy this file to .env and fill in your key. .env is ignored by git.
# No quotes, and no spaces around the = sign.

# Your Anthropic API key (from console.anthropic.com). Leave empty to stay in demo mode.
ANTHROPIC_API_KEY=

# The model that checks claims
MODEL=claude-sonnet-5-5

# The port for npm start
PORT=8000

# Optional: which prompt file to use, e.g. v1 for prompts/system-v1.txt.
# Leave empty to use the highest version in the prompts folder.
PROMPT_VERSION=
